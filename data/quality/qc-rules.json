{
  "version": "1.0",
  "name": "Thermal Shield 360 Data Quality Rules",

  "rules": {
    "air_temperature_c": {
      "type": "numeric",
      "minimum": -80,
      "maximum": 60,
      "required": false
    },

    "relative_humidity_pct": {
      "type": "numeric",
      "minimum": 0,
      "maximum": 100,
      "required": false
    },

    "wind_speed_ms": {
      "type": "numeric",
      "minimum": 0,
      "required": false
    },

    "solar_radiation_wm2": {
      "type": "numeric",
      "minimum": 0,
      "required": false
    },

    "latitude": {
      "type": "numeric",
      "minimum": -90,
      "maximum": 90,
      "required": true
    },

    "longitude": {
      "type": "numeric",
      "minimum": -180,
      "maximum": 180,
      "required": true
    },

    "timestamp": {
      "type": "iso8601",
      "required": true
    },

    "source_id": {
      "type": "string",
      "required": true
    },

    "source_name": {
      "type": "string",
      "required": true
    },

    "retrieved_at": {
      "type": "iso8601",
      "required": true
    }
  },

  "quality_policy": {
    "good": "All available values pass validation and provenance is complete.",
    "acceptable": "Minor non-critical information is missing but the record remains usable.",
    "poor": "One or more environmental values fail validation.",
    "missing": "Required provenance, location or timestamp information is unavailable."
  }
}
